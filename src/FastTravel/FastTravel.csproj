<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Pathoschild.TheLongDarkMods.FastTravel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonsieurMeh.Modding.TLD.Il2CppAssemblies.Windows" />
    <Reference Include="ModData">
      <HintPath>$(ModsPath)\ModData.dll</HintPath>
    </Reference>
    <Reference Include="ModSettings">
      <HintPath>$(ModsPath)\ModSettings.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleasesPath)" />
  </Target>

  <Import Project="..\Common\Common.projitems" Label="Shared" />
</Project>
